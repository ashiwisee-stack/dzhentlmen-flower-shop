# Скопируйте в .dev.vars для локальной разработки. Реальные секреты не коммитьте.
# node scripts/setup-local.mjs создаёт локальные случайные секреты автоматически.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CUSTOMER_AUTH_SECRET=
PUBLIC_ORIGIN=

# SMS.RU: нужны доступ к отправке и положительный баланс.
SMS_RU_API_ID=
# Отдельное включение реальных SMS-кодов. Для теста входа звонком оставить 0.
SMS_RU_SMS_ENABLED=0
# Код на экране разрешён только на localhost/127.0.0.1/terminal.local.
SMS_DEV_MODE=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Включать после заполнения полей и настройки кабинета Робокассы.
ROBOKASSA_ENABLED=0
ROBOKASSA_TEST=1
ROBOKASSA_HASH_ALGORITHM=MD5
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
# Налог, система налогообложения — по реальным данным продавца.
ROBOKASSA_TAX=
ROBOKASSA_SNO=
ROBOKASSA_PAYMENT_METHOD=full_prepayment

# Ваши HTTPS-серверы Nominatim и OSRM с завершающим слешем.
# Без GEOCODER_URL: поиск Photon по кнопке. Без ROUTER_URL: предварительная оценка расстояния.
GEOCODER_URL=
# OSRM Table API, annotations=distance. Public option: https://routing.openstreetmap.de/routed-car/
# Enable road delivery mode in admin after configuring the endpoint.
ROUTER_URL=

# Поиск по кнопке: без GEOCODER_URL используется публичный Photon (небольшая нагрузка).
# Для своего Photon укажите базовый HTTPS URL; disabled выключает публичный поиск.
PHOTON_URL=

# Авторизация звонком SMS.RU, отдельно от SMS-кодов; по умолчанию отключена.
# API-ключ берётся из SMS_RU_API_ID выше. Демо-режим SMS_DEV_MODE не подменяет звонки.
SMS_RU_CALLCHECK_ENABLED=0
# Для теста впишите свой номер в формате 79991234567 (несколько — через запятую).
# Пустое значение разрешает любые российские номера в пределах лимитов.
SMS_RU_CALLCHECK_ALLOWED_PHONES=
# Не более 5 попыток создания за UTC-сутки на весь магазин по умолчанию.
SMS_RU_CALLCHECK_DAILY_LIMIT=5

# Пометка тестового магазина на главной странице.
DEMO_SITE=0
